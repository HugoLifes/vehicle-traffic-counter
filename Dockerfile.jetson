# Imagen de la PLATAFORMA completa (backend + dashboard + IAs de NVIDIA)
# para NVIDIA Jetson Orin Nano, JetPack 6.x.
#
# Usa la imagen oficial de Ultralytics para JetPack 6, que ya trae
# PyTorch, TorchVision, OpenCV y `ultralytics` compilados y probados
# para el Orin (a diferencia del Jetson Nano original, JetPack 6 sí
# trae Python 3.10 — por eso aquí las dependencias del proyecto se
# instalan normal por pip, sin el rodeo que hacía falta para el Nano).
#
# ⚠️ Este Dockerfile asume JetPack 6.x. Confírmalo en el propio Jetson
# con `cat /etc/nv_tegra_release` antes del primer deploy real — si
# resulta ser JetPack 5, solo hay que cambiar el tag de la imagen base
# a `latest-jetson-jetpack5`, nada más cambia.
#
# Build:
#   docker compose -f docker-compose.jetson.yml build
#
# Ver docker-compose.jetson.yml para límites de memoria/CPU, volúmenes
# y cómo correrlo — este Dockerfile solo arma la imagen.

# --- Etapa 1: construir el frontend --------------------------------------
# El Jetson NO ejecuta Node: aquí se compila React a archivos estáticos y
# solo esos archivos pasan a la imagen final. La imagen que corre en el
# equipo no lleva Node, ni npm, ni node_modules.
FROM node:22-alpine AS frontend

WORKDIR /build
# Se copian primero los manifiestos: mientras las dependencias no cambien,
# Docker reutiliza la capa de `npm ci` y el build es mucho más rápido.
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build


# --- Etapa 2: la plataforma ----------------------------------------------
FROM ultralytics/ultralytics:latest-jetson-jetpack6

WORKDIR /app

# Dependencias del proyecto que NO vienen en la imagen base (torch,
# torchvision, opencv, ultralytics, numpy sí vienen — no se reinstalan
# para no romper las versiones compiladas específicamente para el Orin).
COPY requirements-jetson-docker.txt .
RUN pip3 install --no-cache-dir -r requirements-jetson-docker.txt

COPY . .

# El frontend ya construido: FastAPI lo sirve tal cual desde web/dist.
COPY --from=frontend /build/dist ./web/dist

RUN mkdir -p models data data/uploads

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/api/status', timeout=3)" || exit 1

# Plataforma (backend + dashboard) por defecto. Para procesar un video
# puntual con reportes en vez de levantar el servidor:
#   docker compose -f docker-compose.jetson.yml run --rm aforo-vehicular \
#     python3 main.py --source input/video.mp4 --save-video
CMD ["python3", "serve.py"]
